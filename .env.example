# Core Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/dittopdf
JWT_SECRET=replace_with_secure_secret_min_32_chars
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NODE_ENV=development

# Storage Options (choose one)
# AWS S3 Storage
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=

# OR Cloudinary Storage (alternative to S3)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Redis for Background Jobs
REDIS_URL=redis://localhost:6379

# Google AdSense (optional)
NEXT_PUBLIC_ADSENSE_CLIENT_ID=

# =============================================================================
# PHASE 3: AI-POWERED ENTERPRISE PLATFORM
# =============================================================================

# OpenAI Configuration
OPENAI_API_KEY=sk-...

# Stripe Configuration (Billing)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_BUSINESS=price_...
STRIPE_PRICE_ENTERPRISE=price_...

# SSO / SAML Configuration
SAML_CERT=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----

# OAuth Providers (SSO)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=

# Mobile Push Notifications
FCM_SERVER_KEY=AAAA... # Firebase Cloud Messaging
APN_KEY_PATH=/path/to/apn-key.p8
APN_KEY_ID=
APN_TEAM_ID=
IOS_BUNDLE_ID=com.dittopdf.app

# Email Service (SendGrid)
SENDGRID_API_KEY=SG...

# Integration API Keys
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=

# Enterprise Integrations
SHAREPOINT_CLIENT_ID=
SHAREPOINT_CLIENT_SECRET=
SHAREPOINT_TENANT_ID=

# Compliance & Security
ENCRYPTION_KEY= # For encrypting sensitive data at rest
AUDIT_LOG_RETENTION_DAYS=365

# Analytics
MIXPANEL_TOKEN= # Optional - for advanced analytics
SEGMENT_WRITE_KEY= # Optional - for event tracking

# Feature Flags
ENABLE_AI_FEATURES=true
ENABLE_WORKFLOWS=true
ENABLE_BILLING=true
ENABLE_SSO=true
ENABLE_WHITELABEL=true

# Rate Limiting
RATE_LIMIT_AI_REQUESTS=50
RATE_LIMIT_WORKFLOW_RUNS=100
RATE_LIMIT_WINDOW_MS=3600000

# File Processing
MAX_FILE_SIZE_MB=250
MAX_AI_TOKENS_PER_REQUEST=8000

# =============================================================================
# PHASE 4: GLOBAL PLATFORM & ADVANCED AI
# =============================================================================

# Multi-Cloud Configuration
# Primary Provider (AWS/Azure/GCP)
PRIMARY_CLOUD_PROVIDER=aws
AWS_ACCESS_KEY_ID_GCP= # For GCP with AWS-compatible API
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_KEY=
GCP_PROJECT_ID=
GCP_SERVICE_ACCOUNT_KEY= # JSON key content

# Global CDN / Edge Configuration
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
AWS_CLOUDFRONT_DISTRIBUTION_ID=

# Elasticsearch for Search & Analytics
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=

# Kafka for Event Streaming
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=dittopdf
KAFKA_GROUP_ID=dittopdf-consumers

# Prometheus Metrics
PROMETHEUS_PORT=9090
ENABLE_METRICS_EXPORT=true

# Jaeger Tracing
JAEGER_AGENT_HOST=localhost
JAEGER_AGENT_PORT=6831

# Fraud Detection
ENABLE_FRAUD_DETECTION=true
FRAUD_DETECTION_THRESHOLD=0.7
MAX_RISK_SCORE_BEFORE_BLOCK=0.9

# Financial Integrations
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_SANDBOX=true

# Marketplace
MARKETPLACE_PLATFORM_FEE_PERCENT=30
MARKETPLACE_DEVELOPER_SHARE_PERCENT=70

# Compliance
ENABLE_COMPLIANCE_MONITORING=true
ISO27001_AUDIT_INTERVAL_DAYS=90
SOC2_AUDIT_INTERVAL_DAYS=90

# API Gateway
DEFAULT_RATE_LIMIT_PER_MINUTE=1000
DEFAULT_BURST_LIMIT=2000
CIRCUIT_BREAKER_ERROR_THRESHOLD=50
CIRCUIT_BREAKER_RESET_TIMEOUT_MS=30000

# ML Model Training
ML_MODEL_TRAINING_ENABLED=true
ML_MODEL_RETRAIN_INTERVAL_HOURS=168
TENSORFLOW_BACKEND=cpu

# Executive Dashboards
EXECUTIVE_DASHBOARD_REFRESH_INTERVAL_SEC=300
ENABLE_REALTIME_ANALYTICS=true
