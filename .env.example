# =============================================================================
# PDFToolsHub — Environment Configuration
# =============================================================================

# --- Core ---
NODE_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Authentication ---
# Required for auth. Use a long random string: `openssl rand -hex 32`
JWT_SECRET=replace_with_secure_secret_min_32_chars

# --- Database (optional for the 26 tools; required for accounts & history) ---
# DATABASE_URL=postgresql://user:password@localhost:5432/pdftoolshub

# --- Storage (optional; defaults to local disk) ---
# AWS S3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=
# OR Cloudinary
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# --- Public API ---
# Required to enable POST /api/public/process (x-api-key header)
# PUBLIC_API_KEY=

# --- OCR ---
# Optional: pre-seed tesseract language data to avoid first-run download.
# Point to a directory containing e.g. eng.traineddata
# TESSERACT_DATA_DIR=/var/lib/tessdata

# --- File Processing ---
MAX_FILE_SIZE_MB=50
# Time in minutes before unowned uploads are cleaned up
FILE_CLEANUP_TTL_MINUTES=60

# --- Rate Limiting ---
# Requests per tool, per user/IP, per sliding window
RATE_LIMIT_MAX_REQUESTS=20
RATE_LIMIT_WINDOW_MS=60000