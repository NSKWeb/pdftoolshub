  aiManaged         Boolean             @default(true)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([partnerName])
  @@index([status])
}

model CompetitiveIntelligence {
  id                String              @id @default(cuid())
  competitorName    String
  analysisType      String
  marketSegment     String
  intelligenceData  Json
  threatLevel       String              @default("low")
  opportunityScore  Float               @default(0.0)
  actionRecommended String?
  aiConfidence      Float               @default(0.0)
  createdAt         DateTime            @default(now())

  @@index([competitorName])
  @@index([marketSegment])
}

model AutonomousRevenue {
  id                String              @id @default(cuid())
  revenueStream     String
  optimizationType  String
  aiModelUsed       String
  baselineRevenue   Float
  optimizedRevenue  Float
  improvementPercent Float
  pricingStrategy   Json?
  marketConditions  Json?
  appliedAt         DateTime            @default(now())

  @@index([revenueStream])
  @@index([appliedAt])
}

model GlobalExpansion {
  id                String              @id @default(cuid())
  regionCode        String
  regionName        String
  expansionStage    String              @default("research")
  entryStrategy     String
  investmentAmount  Float
  projectedRevenue  Float
  actualRevenue     Float?
