  culturalAdaptation Json?
  aiRecommendations Json?
  startedAt         DateTime            @default(now())
  launchedAt        DateTime?

  @@index([regionCode])
  @@index([expansionStage])
}

model PostIpoOperations {
  id                String              @id @default(cuid())
  operationType     String
  quarter           String
  year              Int
  sharePrice        Float
  marketCap         Float
  tradingVolume     BigInt
  shareholderMetrics Json?
  boardDecisions    Json?
  aiRecommendations Json?
  autonomousActions Int                 @default(0)
