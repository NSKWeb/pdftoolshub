  @@index([userId])
  @@index([jobType])
  @@index([status])
}

model DocumentRoutingRules {
  id                String              @id @default(cuid())
  tenantId          String
  name              String
  description       String?
  conditions        Json
  actions           Json
  priority          Int                 @default(0)
  isActive          Boolean             @default(true)
  matchCount        Int                 @default(0)
  successRate       Float               @default(0)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([tenantId])
  @@index([isActive])
  @@index([priority])
}

model AIQualityAssurance {
  id                String              @id @default(cuid())
  documentId        String
  fileId            String?
  tenantId          String?
  checkType         String
  qualityScore      Float
  issues            Json?
  recommendations   Json?
  automatedFixes    Json?
  status            String              @default("completed")
  reviewedBy        String?
  reviewedAt        DateTime?
  createdAt         DateTime            @default(now())

  @@index([documentId])
  @@index([tenantId])
  @@index([checkType])
}

// Phase 5: Quantum Computing
model QuantumProcessing {
  id                String              @id @default(cuid())
  userId            String
  fileId            String?
  quantumAlgorithm  String
  processingTime    Float
  speedImprovement  Float
  quantumComputer   String
  createdAt         DateTime            @default(now())
  user              Users               @relation(fields: [userId], references: [id])
  file              Files?              @relation(fields: [fileId], references: [id])

  @@index([userId])
  @@index([fileId])
}

// Phase 5: Blockchain Verification
model BlockchainVerification {
  id                    String              @id @default(cuid())
  fileId                String
  blockchainNetwork     String
  transactionHash       String
  blockNumber           BigInt
  smartContractAddress  String
  verificationStatus    String
  createdAt             DateTime            @default(now())
  file                  Files               @relation(fields: [fileId], references: [id])

  @@index([fileId])
  @@index([transactionHash])
}

// Phase 5: Advanced AI Models
model Phase5AiModels {
  id                String              @id @default(cuid())
  modelName         String
  modelType         String
  version           String
  accuracyScore     Float
  trainingDataSize  BigInt
  inferenceSpeed    Float
  isActive          Boolean             @default(true)
  createdAt         DateTime            @default(now())
}

// Phase 5: Autonomous Systems
model AutonomousSystems {
  id                  String              @id @default(cuid())
  systemType          String
  status              String
