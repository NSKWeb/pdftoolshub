  lockInFactor      Float               @default(0.90)
  partnerCount      Int                 @default(0)
  metrics           Json?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([platformId])
  @@index([marketPosition])
}

model IndustryStandards {
  id                String              @id @default(cuid())
  standardId        String              @unique
  standardName      String
  description       String?
  category          String
  adoptionRate      Float               @default(0.0)
  influenceScore    Float               @default(0.0)
  regulatoryBody    String?
  relatedProducts   String[]
