}

// Phase 5: Global Markets
model GlobalMarkets {
  id                      String              @id @default(cuid())
  countryCode             String
  currency                String
  languageCode            String
  complianceRequirements  Json
  marketSize              BigInt
  marketShare             Float
  createdAt               DateTime            @default(now())
}

// Phase 6: Autonomous Business Operations
model AutonomousDecisions {
  id                String              @id @default(cuid())
  decisionType      String
  decisionContext   Json
