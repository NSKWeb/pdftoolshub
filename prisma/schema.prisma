  competitorImpact  Json?
  marketShareGain   Float               @default(0.0)
  startedAt         DateTime            @default(now())
  completedAt       DateTime?

  @@index([targetMarket])
  @@index([status])
}

model StrategicPartnerships {
  id                String              @id @default(cuid())
